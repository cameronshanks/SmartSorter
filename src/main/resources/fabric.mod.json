{
  "schemaVersion": 1,
  "id": "smartsorter",
  "version": "${version}",
  "name": "Smart Sorter",
  "description": "Smart inventory sorting and management. Maintained fork of Smart Sorter by Shaddii, with bulk chest editing, whitelist filters, faster routing, a non-blocking intake buffer and optional chunk keeping.",
  "authors": ["Shaddii", "Cameron Shanks"],
  "contact": {
    "homepage": "https://github.com/cameronshanks/SmartSorter",
    "sources": "https://github.com/cameronshanks/SmartSorter",
    "issues": "https://github.com/cameronshanks/SmartSorter/issues"
  },
  "license": "MIT",
  "icon": "assets/smartsorter/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "net.shaddii.smartsorter.SmartSorter"
    ],
    "client": [
      "net.shaddii.smartsorter.client.SmartSorterClient"
    ]
  },

  "mixins": [
    "smartsorter.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": ">=26.1 <26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}